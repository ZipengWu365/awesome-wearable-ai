{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "record_id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]+$"
      },
      "layers": {
        "type": "array",
        "items": {
          "enum": [
            "reasoning",
            "function_variables",
            "interventions"
          ]
        },
        "uniqueItems": true,
        "minItems": 1
      },
      "functions": {
        "type": "array",
        "items": {
          "enum": [
            "identity",
            "activity_behavior",
            "physiological_state",
            "sleep_circadian",
            "disease_risk",
            "functional_status",
            "context_receptivity",
            "measurement_quality"
          ]
        },
        "uniqueItems": true,
        "minItems": 1
      },
      "state_variables": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true,
        "minItems": 1
      },
      "action_space": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true,
        "minItems": 1
      },
      "source_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true,
        "minItems": 1
      },
      "reviewed_on": {
        "type": "string",
        "format": "date"
      },
      "classification_origin": {
        "const": "curator_assessment"
      },
      "model_mechanism": {
        "type": "string",
        "minLength": 1
      },
      "data_linkage": {
        "type": "string",
        "minLength": 1
      },
      "time_scope": {
        "type": "string",
        "minLength": 1
      },
      "validation_scope": {
        "type": "string",
        "minLength": 1
      },
      "claim_boundary": {
        "type": "string",
        "minLength": 1
      },
      "theme_role": {
        "enum": [
          "reported_twin",
          "conceptual_framework",
          "method_enabler",
          "synthetic_data_analogue"
        ]
      },
      "application": {
        "enum": [
          "framework",
          "cardiovascular",
          "musculoskeletal",
          "metabolic",
          "hydration",
          "bladder_sensor_design",
          "respiratory",
          "synthetic_data",
          "behavioral"
        ]
      },
      "entity": {
        "enum": [
          "individual_organ",
          "individual_person",
          "subpopulation",
          "synthetic_cohort",
          "conceptual",
          "not_applicable"
        ]
      },
      "wearable_relation": {
        "enum": [
          "direct_wrist",
          "wrist_and_other_wearable",
          "multi_location_wearable",
          "other_wearable",
          "wearable_driven_mixed_sources",
          "clinical_signal_transfer",
          "methodological_reference",
          "wearable_context_proposed"
        ]
      },
      "personalization": {
        "enum": [
          "person_specific",
          "group_conditioned",
          "anatomy_plus_external_streams",
          "synthetic_matching",
          "proposed",
          "not_applicable",
          "not_reported"
        ]
      },
      "update_mode": {
        "enum": [
          "stream_driven_offline",
          "online_state_update",
          "periodic_retraining",
          "offline_calibration_replay",
          "not_appraised",
          "not_applicable",
          "proposed"
        ]
      },
      "simulation_kind": {
        "enum": [
          "factual_state_reconstruction",
          "mechanistic_what_if",
          "predictive_input_scenarios",
          "synthetic_data_generation",
          "population_policy_simulation",
          "model_based_effect_estimation",
          "not_evaluated",
          "framework_only"
        ]
      },
      "execution": {
        "enum": [
          "none",
          "simulation_only",
          "human_reviewed_advice",
          "patient_decision_support",
          "automated_device_control",
          "human_adjustment_with_device_control",
          "proposed",
          "not_applicable"
        ]
      },
      "evaluation": {
        "type": "array",
        "items": {
          "enum": [
            "numerical_verification",
            "measurement_comparison",
            "retrospective_prediction",
            "trial_data_replay",
            "randomized_intervention",
            "pilot_human_study",
            "software_interface",
            "review_or_framework",
            "synthetic_privacy_utility"
          ]
        },
        "uniqueItems": true,
        "minItems": 1
      },
      "causal_status": {
        "enum": [
          "not_identified",
          "assumption_dependent_simulation",
          "randomized_bundle_only",
          "not_applicable",
          "not_appraised"
        ]
      },
      "review_scope": {
        "enum": [
          "primary_sections",
          "abstract_metadata",
          "abstract_and_open_reviews",
          "prior_version_annotation"
        ]
      }
    },
    "required": [
      "record_id",
      "layers",
      "functions",
      "state_variables",
      "action_space",
      "source_ids",
      "reviewed_on",
      "classification_origin",
      "model_mechanism",
      "data_linkage",
      "time_scope",
      "validation_scope",
      "claim_boundary",
      "theme_role",
      "application",
      "entity",
      "wearable_relation",
      "personalization",
      "update_mode",
      "simulation_kind",
      "execution",
      "evaluation",
      "causal_status",
      "review_scope"
    ],
    "additionalProperties": false
  },
  "uniqueItems": true,
  "minItems": 0
}
