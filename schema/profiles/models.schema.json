{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Awesome Wearable AI models",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
      },
      "scope_tier": {
        "enum": [
          "core",
          "adjacent"
        ]
      },
      "curation_level": {
        "enum": [
          "metadata_checked",
          "evidence_appraised"
        ]
      },
      "source_ids": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "field_sources": {
        "type": "object",
        "propertyNames": {
          "enum": [
            "id",
            "scope_tier",
            "curation_level",
            "source_ids",
            "field_sources",
            "related_ids",
            "added_on",
            "last_verified",
            "model_name",
            "paper",
            "year",
            "venue",
            "official_code",
            "official_weights",
            "model_family",
            "wearable_native",
            "sensor_modalities",
            "input_type",
            "sampling_frequency",
            "pretraining_dataset",
            "pretraining_scale",
            "n_subjects",
            "n_hours",
            "self_supervised",
            "foundation_model",
            "zero_shot",
            "classification",
            "forecasting",
            "imputation",
            "anomaly_detection",
            "har",
            "sleep",
            "health_prediction",
            "cross_device",
            "multimodal",
            "parameter_count",
            "license",
            "commercial_use",
            "notes",
            "publication_status",
            "capability_notes"
          ]
        },
        "additionalProperties": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "related_ids": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "added_on": {
        "type": "string",
        "format": "date"
      },
      "last_verified": {
        "type": "string",
        "format": "date"
      },
      "model_name": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "const": "unknown"
          }
        ]
      },
      "paper": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^https?://[^\\s]+$"
          },
          {
            "const": "unknown"
          }
        ]
      },
      "year": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "const": "unknown"
          }
        ]
      },
      "venue": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "const": "unknown"
          }
        ]
      },
      "official_code": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^https?://[^\\s]+$"
          },
          {
            "const": "unknown"
          }
        ]
      },
      "official_weights": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^https?://[^\\s]+$"
          },
          {
            "const": "unknown"
          }
        ]
      },
      "model_family": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "const": "unknown"
          }
        ]
      },
      "wearable_native": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "const": "unknown"
          }
        ]
      },
      "sensor_modalities": {
        "anyOf": [
          {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          {
            "const": "unknown"
          }
        ]
      },
      "input_type": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "const": "unknown"
          }
        ]
      },
      "sampling_frequency": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "const": "unknown"
          }
        ]
      },
      "pretraining_dataset": {
        "anyOf": [
          {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          {
            "const": "unknown"
          }
        ]
      },
      "pretraining_scale": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "const": "unknown"
          }
        ]
      },
      "n_subjects": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "const": "unknown"
          }
        ]
      },
      "n_hours": {
        "anyOf": [
          {
            "type": "number",
            "minimum": 0
          },
          {
            "const": "unknown"
          }
        ]
      },
      "self_supervised": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "const": "unknown"
          }
        ]
      },
      "foundation_model": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "const": "unknown"
          }
        ]
      },
      "zero_shot": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "const": "unknown"
          }
        ]
      },
      "classification": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "const": "unknown"
          }
        ]
      },
      "forecasting": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "const": "unknown"
          }
        ]
      },
      "imputation": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "const": "unknown"
          }
        ]
      },
      "anomaly_detection": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "const": "unknown"
          }
        ]
      },
      "har": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "const": "unknown"
          }
        ]
      },
      "sleep": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "const": "unknown"
          }
        ]
      },
      "health_prediction": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "const": "unknown"
          }
        ]
      },
      "cross_device": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "const": "unknown"
          }
        ]
      },
      "multimodal": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "const": "unknown"
          }
        ]
      },
      "parameter_count": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "const": "unknown"
          }
        ]
      },
      "license": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "const": "unknown"
          }
        ]
      },
      "commercial_use": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "const": "unknown"
          }
        ]
      },
      "notes": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "const": "unknown"
          }
        ]
      },
      "publication_status": {
        "enum": [
          "peer_reviewed",
          "accepted_in_press",
          "preprint",
          "official_report",
          "unknown"
        ]
      },
      "capability_notes": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "const": "unknown"
          }
        ]
      }
    },
    "required": [
      "id",
      "scope_tier",
      "curation_level",
      "source_ids",
      "field_sources",
      "related_ids",
      "added_on",
      "last_verified",
      "model_name",
      "paper",
      "year",
      "venue",
      "official_code",
      "official_weights",
      "model_family",
      "wearable_native",
      "sensor_modalities",
      "input_type",
      "sampling_frequency",
      "pretraining_dataset",
      "pretraining_scale",
      "n_subjects",
      "n_hours",
      "self_supervised",
      "foundation_model",
      "zero_shot",
      "classification",
      "forecasting",
      "imputation",
      "anomaly_detection",
      "har",
      "sleep",
      "health_prediction",
      "cross_device",
      "multimodal",
      "parameter_count",
      "license",
      "commercial_use",
      "notes",
      "publication_status",
      "capability_notes"
    ],
    "additionalProperties": false
  }
}
