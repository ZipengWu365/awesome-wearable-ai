{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Awesome Wearable AI devices",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
      },
      "scope_tier": {
        "enum": [
          "core",
          "adjacent"
        ]
      },
      "curation_level": {
        "enum": [
          "metadata_checked",
          "evidence_appraised"
        ]
      },
      "source_ids": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "field_sources": {
        "type": "object",
        "propertyNames": {
          "enum": [
            "id",
            "scope_tier",
            "curation_level",
            "source_ids",
            "field_sources",
            "related_ids",
            "added_on",
            "last_verified",
            "device_name",
            "manufacturer",
            "url",
            "device_type",
            "body_location",
            "sensor_modalities",
            "research_use",
            "raw_export",
            "sampling_frequency_hz",
            "sdk",
            "license",
            "status",
            "notes"
          ]
        },
        "additionalProperties": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "related_ids": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "added_on": {
        "type": "string",
        "format": "date"
      },
      "last_verified": {
        "type": "string",
        "format": "date"
      },
      "device_name": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "const": "unknown"
          }
        ]
      },
      "manufacturer": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "const": "unknown"
          }
        ]
      },
      "url": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^https?://[^\\s]+$"
          },
          {
            "const": "unknown"
          }
        ]
      },
      "device_type": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "const": "unknown"
          }
        ]
      },
      "body_location": {
        "anyOf": [
          {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          {
            "const": "unknown"
          }
        ]
      },
      "sensor_modalities": {
        "anyOf": [
          {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          {
            "const": "unknown"
          }
        ]
      },
      "research_use": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "const": "unknown"
          }
        ]
      },
      "raw_export": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "const": "unknown"
          }
        ]
      },
      "sampling_frequency_hz": {
        "anyOf": [
          {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          {
            "const": "unknown"
          }
        ]
      },
      "sdk": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^https?://[^\\s]+$"
          },
          {
            "const": "unknown"
          }
        ]
      },
      "license": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "const": "unknown"
          }
        ]
      },
      "status": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "const": "unknown"
          }
        ]
      },
      "notes": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "const": "unknown"
          }
        ]
      }
    },
    "required": [
      "id",
      "scope_tier",
      "curation_level",
      "source_ids",
      "field_sources",
      "related_ids",
      "added_on",
      "last_verified",
      "device_name",
      "manufacturer",
      "url",
      "device_type",
      "body_location",
      "sensor_modalities",
      "research_use",
      "raw_export",
      "sampling_frequency_hz",
      "sdk",
      "license",
      "status",
      "notes"
    ],
    "additionalProperties": false
  }
}
