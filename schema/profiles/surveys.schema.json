{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Awesome Wearable AI surveys",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
      },
      "scope_tier": {
        "enum": [
          "core",
          "adjacent"
        ]
      },
      "curation_level": {
        "enum": [
          "metadata_checked",
          "evidence_appraised"
        ]
      },
      "source_ids": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "field_sources": {
        "type": "object",
        "propertyNames": {
          "enum": [
            "id",
            "scope_tier",
            "curation_level",
            "source_ids",
            "field_sources",
            "related_ids",
            "added_on",
            "last_verified",
            "title",
            "paper_id",
            "url",
            "year",
            "venue",
            "category",
            "scope",
            "notes"
          ]
        },
        "additionalProperties": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "related_ids": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "added_on": {
        "type": "string",
        "format": "date"
      },
      "last_verified": {
        "type": "string",
        "format": "date"
      },
      "title": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "const": "unknown"
          }
        ]
      },
      "paper_id": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "const": "unknown"
          }
        ]
      },
      "url": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^https?://[^\\s]+$"
          },
          {
            "const": "unknown"
          }
        ]
      },
      "year": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "const": "unknown"
          }
        ]
      },
      "venue": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "const": "unknown"
          }
        ]
      },
      "category": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "const": "unknown"
          }
        ]
      },
      "scope": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "const": "unknown"
          }
        ]
      },
      "notes": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "const": "unknown"
          }
        ]
      }
    },
    "required": [
      "id",
      "scope_tier",
      "curation_level",
      "source_ids",
      "field_sources",
      "related_ids",
      "added_on",
      "last_verified",
      "title",
      "paper_id",
      "url",
      "year",
      "venue",
      "category",
      "scope",
      "notes"
    ],
    "additionalProperties": false
  }
}
